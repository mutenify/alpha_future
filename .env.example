# Backend
POSTGRES_DB=smartcredit
POSTGRES_USER=smartcredit
POSTGRES_PASSWORD=smartcredit
DB_DSN=postgres://smartcredit:smartcredit@postgres:5432/smartcredit?sslmode=disable
DEMO_AUTH=true
ML_SERVICE_URL=http://ml-mock:8081
JWT_SECRET=demo-only-change-me
MOCK_TIMEOUT=3s
WORKER_ENABLED=true
CORS_ORIGIN=http://localhost:3000

# Optional OpenAI-compatible LLM endpoint. Empty values enable the rules fallback.
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=

# Optional local open-weights model served by Ollama.
# Пусто — Ollama не используется. Для локальной модели: http://host.docker.internal:11434
OLLAMA_URL=
OLLAMA_MODEL=qwen2.5:3b
